# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files — .env holds the backend URL, .env.example is committed
.env
.env*.local

# typescript
*.tsbuildinfo

example

# generated native folders
/ios
/android

# snapshot of the build the live demo link is serving
.demo-live-backup/
dist-next/

# server credentials — never commit
.env-server
.env.server
*.pem
*_rsa
*_ed25519
