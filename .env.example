# Copy to .env — everything here is optional.
# Without it the app runs entirely on the Simulated Reader, which is the safe
# default for a live pitch.

# Where server/index.mjs is reachable from the phone. Must be the Mac's LAN IP,
# not localhost — the phone can't reach your laptop's loopback.
# EXPO_PUBLIC_TERMINAL_BACKEND_URL=http://192.168.1.20:4242

# Shown on the OS "Tap to Pay" sheet.
# EXPO_PUBLIC_MERCHANT_NAME=splitabroad (test)

# Use Stripe's *Simulated Reader* through the real SDK instead of the phone's
# NFC radio. Handy on the iOS Simulator or where Tap to Pay is region-locked.
# EXPO_PUBLIC_TERMINAL_SIMULATED=1
